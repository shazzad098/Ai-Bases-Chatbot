# --- Database ---
DATABASE_URL=postgresql+asyncpg://nichedesk:nichedesk@localhost:5432/nichedesk
# Local dev without docker: set USE_SQLITE=1 to use sqlite fallback
USE_SQLITE=0
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-super-secret
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=30

# --- AI ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
AI_GATEWAY_PROVIDER=openai

# --- Storage (S3-compatible / R2) ---
S3_ENDPOINT=
S3_BUCKET=nichedesk-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENV=dev
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
